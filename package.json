{
  "name": "tuflow-helper",
  "displayName": "TUFLOW Helper",
  "description": "Syntax highlighting and IntelliSense for TUFLOW files",
  "version": "0.8.2",
  "publisher": "lmillard79",
  "icon": "images/ico.png",
  "galleryBanner": {
    "color": "#2c3e50",
    "theme": "dark"
  },
  "homepage": "https://github.com/Chain-Frost/tuflow-vscode/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/Chain-Frost/tuflow-vscode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chain-Frost/tuflow-vscode.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:tuflow-helper"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tuflow-helper",
        "aliases": [
          "TUFLOW",
          "tuflow"
        ],
        "extensions": [
          ".tcf",
          ".ecf",
          ".tbc",
          ".tef",
          ".tgc",
          ".tmf",
          ".ebc",
          ".egf",
          ".rdf",
          ".trd",
          ".erd",
          ".elf",
          ".tlf",
          ".trfcf",
          ".trfc",
          ".toc",
          ".qcf",
          ".fvc",
          ".fvm",
          ".fvsed",
          ".fvptm",
          ".mcf",
          ".fvwq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tuflow-helper",
        "scopeName": "source.tuflow",
        "path": "./syntaxes/tuflow.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tuflow-helper",
        "path": "./snippets/tuflow.json"
      }
    ],
    "commands": [
      {
        "command": "tuflow-helper.openFileUnderCursor",
        "title": "Open File Under Cursor",
        "category": "TUFLOW"
      },
      {
        "command": "tuflow-helper.openDocumentation",
        "title": "Open Documentation",
        "category": "TUFLOW"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus && editorLangId == tuflow-helper",
          "command": "tuflow-helper.openFileUnderCursor",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit && npm run test:extension",
    "test:unit": "node --test test/unit/commands.test.cjs",
    "test:extension": "npm exec --yes --package=@vscode/test-cli@0.0.15 -- vscode-test",
    "package:vsix": "npm run compile && npm exec --yes --package=@vscode/vsce@3.7.1 -- vsce package --no-dependencies --out tuflow-helper.vsix && node scripts/verify-vsix.cjs tuflow-helper.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "__metadata": {
    "id": "0805575c-1827-403e-9b99-d2f77f2c84a9",
    "publisherId": "724e0895-6846-4103-9c3b-04710b69098d",
    "publisherDisplayName": "lmillard79"
  }
}
